# Copy to .env and fill in as needed. Local Docker Compose defaults already
# work without editing anything — see docs/ENVIRONMENT_VARIABLES.md for the
# full reference. Never commit a real .env file (see .gitignore).

# ---- Core ----
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=dev-insecure-secret-change-me
DATABASE_URL=postgresql+psycopg://agora:agora@localhost:5432/agora
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_DEPLOYMENT_MODE=local
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=agora-local
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=agora-secret
S3_REGION=eu-central-1

# ---- Sessions / cookies ----
SESSION_COOKIE_NAME=agora_session
SESSION_TTL_HOURS=336
COOKIE_SECURE=false

# ---- AI providers (optional — omit to run in demo mode) ----
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Sales Lead Finder data provider: Apollo (optional) ----
# Apollo is CUSTOMER-CONNECTED: each organization authorizes its own Apollo
# workspace via OAuth 2.0 and spends its own Apollo credits. These configure
# the Veyntra OAuth *application* (one per deployment) — never a
# customer credential. See docs/APOLLO_CUSTOMER_OAUTH_ARCHITECTURE.md.
#
# Register the app in Apollo (Settings -> Integrations -> API/OAuth), upload
# the approved logo, and register the exact HTTPS callback URL below. Apollo
# requires HTTPS, so local development needs an HTTPS tunnel.
APOLLO_OAUTH_CLIENT_ID=
# Backend-only. Never a NEXT_PUBLIC_* variable, never returned to the
# frontend, never logged, never committed. Use a Render secret env var in
# production.
APOLLO_OAUTH_CLIENT_SECRET=
APOLLO_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/apollo/callback

# Non-secret endpoints — defaults are correct for Apollo today; override only
# if Apollo changes them.
# APOLLO_OAUTH_AUTHORIZE_URL=https://app.apollo.io/#/oauth/authorize
# APOLLO_OAUTH_TOKEN_URL=https://app.apollo.io/api/v1/oauth/token
# APOLLO_API_BASE_URL=https://api.apollo.io/api/v1

# "oauth" (default, and the only value permitted in production) or "api_key"
# (legacy local-development/test mode only). The process refuses to start
# with "api_key" while APP_ENV=production — one shared key must never serve
# multiple customers.
APOLLO_AUTH_MODE=oauth
# Used only when APOLLO_AUTH_MODE=api_key. Leave blank in normal operation;
# organizations without a connection get clearly-labeled demo data.
APOLLO_API_KEY=

# ---- Email (optional — omit to log reset links instead of sending email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SES_REGION=

# ---- Billing (optional) ----
# Leave these blank and the Starter trial still works completely (it takes
# no card); checkout refuses with an honest 409 instead of faking a
# purchase, and the billing page disables its upgrade buttons. See
# docs/BILLING_ARCHITECTURE.md before enabling in production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Dashboard. Without it, webhooks cannot be verified and are rejected —
# which means no purchase can ever be completed.
STRIPE_WEBHOOK_SECRET=
# Recurring EUR Price ids for the two self-serve paid plans. Starter is
# trial-only and Enterprise is contract-only, so neither has one.
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=
# Length of the no-card Starter trial.
TRIAL_PERIOD_DAYS=14

# ---- Integrations (optional) ----
# Every OAuth provider below follows the same shape: CLIENT_ID/
# CLIENT_SECRET/REDIRECT_URI. Omit any provider's variables to leave its
# connector reporting "Not configured" in /settings/integrations — a mock
# adapter still lets that provider's OAuth flow be exercised end to end
# for demo/testing, but the real connector never activates without real
# credentials (spec §82: never a fake "connected" state). Fill these in
# later and the real adapter activates automatically — no code changes
# needed (see docs/DECISIONS.md ADR-0028).

# HubSpot — create a developer app at https://developers.hubspot.com/,
# then set its redirect URI to match HUBSPOT_REDIRECT_URI below.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/hubspot/callback

# Google — create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application), then add GOOGLE_REDIRECT_URI as an authorized
# redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/google/callback

# Microsoft — register an app at https://portal.azure.com/ (Azure AD App
# registrations), add MICROSOFT_REDIRECT_URI as a redirect URI, and create
# a client secret under "Certificates & secrets".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/microsoft/callback

# GitHub — create an OAuth App at https://github.com/settings/developers,
# then set its "Authorization callback URL" to GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/github/callback

# Slack — create an app at https://api.slack.com/apps, add
# SLACK_REDIRECT_URI under "OAuth & Permissions" -> "Redirect URLs".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8vv000/api/v1/integrations/connections/oauth/slack/callback

# Salesforce — create a Connected App in Setup -> App Manager, then set
# its "Callback URL" to SALESFORCE_REDIRECT_URI below.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/salesforce/callback

# Zendesk — unlike the providers above, a Zendesk OAuth client is
# registered against one specific customer subdomain rather than a
# multi-tenant authorize URL, so ZENDESK_SUBDOMAIN is also required (the
# subdomain in https://{subdomain}.zendesk.com). Create the OAuth client
# under Admin Center -> Apps and integrations -> APIs -> Zendesk API ->
# OAuth Clients, then set its redirect URL to ZENDESK_REDIRECT_URI below.
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/zendesk/callback
ZENDESK_SUBDOMAIN=

# Pipedrive — create an app at https://app.pipedrive.com/developer-hub,
# then set its callback URL to PIPEDRIVE_REDIRECT_URI below.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/pipedrive/callback

# Intercom — create an app at https://app.intercom.com/a/apps/_/developer-hub,
# then set its redirect URL to INTERCOM_REDIRECT_URI below.
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
INTERCOM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/intercom/callback

# Encrypts stored OAuth tokens at rest (Fernet — generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# Omit in development to derive a key from SECRET_KEY instead (fine for
# local/test use only); a real deployment must set its own — see
# docs/KNOWN_LIMITATIONS.md.
TOKEN_ENCRYPTION_KEY=

# ---- Frontend (Next.js — only NEXT_PUBLIC_* is ever sent to the browser) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
