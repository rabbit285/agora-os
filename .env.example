# Copy to .env and fill in as needed. Local Docker Compose defaults already
# work without editing anything — see docs/ENVIRONMENT_VARIABLES.md for the
# full reference. Never commit a real .env file (see .gitignore).

# ---- Core ----
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=dev-insecure-secret-change-me
DATABASE_URL=postgresql+psycopg://agora:agora@localhost:5432/agora
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_DEPLOYMENT_MODE=local
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=agora-local
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=agora-secret
S3_REGION=eu-central-1

# ---- Sessions / cookies ----
SESSION_COOKIE_NAME=agora_session
SESSION_TTL_HOURS=336
COOKIE_SECURE=false

# ---- AI providers (optional — omit to run in demo mode) ----
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Email (optional — omit to log reset links instead of sending email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SES_REGION=

# ---- Billing (optional) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Integrations (optional) ----
# HubSpot OAuth app credentials — omit to leave the HubSpot connector
# reporting "Not configured" in /settings/integrations (a mock adapter
# still lets the OAuth flow be exercised end to end for demo/testing, but
# the real connector never activates without these). Create a developer
# app at https://developers.hubspot.com/, then set the redirect URI there
# to match HUBSPOT_REDIRECT_URI below.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/connections/oauth/hubspot/callback
# Encrypts stored OAuth tokens at rest (Fernet — generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# Omit in development to derive a key from SECRET_KEY instead (fine for
# local/test use only); a real deployment must set its own — see
# docs/KNOWN_LIMITATIONS.md.
TOKEN_ENCRYPTION_KEY=

# ---- Frontend (Next.js — only NEXT_PUBLIC_* is ever sent to the browser) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
