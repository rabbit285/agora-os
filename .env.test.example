# Environment for running the backend test suite. Tests use an in-memory
# SQLite database by default (see apps/api/tests/conftest.py) so this file
# is only needed for integration tests that specifically target Postgres.
APP_ENV=test
SECRET_KEY=test-secret
DATABASE_URL=postgresql+psycopg://agora:agora@localhost:5432/agora_test
REDIS_URL=redis://localhost:6379/1
AI_PROVIDER=demo
COOKIE_SECURE=false

# Apollo stays unconfigured in tests: the OAuth flow is exercised against
# the mock adapter (app/integrations/adapters/mock.py) and Lead Finder
# searches return deterministic demo data. Automated tests must never
# consume a real customer's Apollo credits, so no real client credentials
# or API key belong here.
APOLLO_AUTH_MODE=oauth
APOLLO_OAUTH_CLIENT_ID=
APOLLO_OAUTH_CLIENT_SECRET=
APOLLO_API_KEY=
