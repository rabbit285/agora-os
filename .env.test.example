# Environment for running the backend test suite. Tests use an in-memory
# SQLite database by default (see apps/api/tests/conftest.py) so this file
# is only needed for integration tests that specifically target Postgres.
APP_ENV=test
SECRET_KEY=test-secret
DATABASE_URL=postgresql+psycopg://agora:agora@localhost:5432/agora_test
REDIS_URL=redis://localhost:6379/1
AI_PROVIDER=demo
COOKIE_SECURE=false
